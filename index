<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กำลังดำเนินการแชร์ข้อความ...</title>
    <!-- 1. นำเข้า SDK ของระบบ LINE LIFF -->
    <script src="https://line-scdn.net"></script>
    <style>
        body { font-family: sans-serif; text-align: center; padding-top: 50px; color: #555; }
        .loader { border: 4px solid #f3f3f3; border-top: 4px solid #1DB446; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 20px auto; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

    <div class="loader"></div>
    <p id="status-text">กำลังเริ่มต้นระบบแชร์ข้อความ...</p>

    <script>
        // ⭐️ เปลี่ยนเป็นรหัส LIFF ID ของคุณที่ได้มาจาก LINE Developers Console
        const MY_LIFF_ID = "2011437100-YADN8PIm"; 

        async function main() {
            try {
                // 2. เริ่มต้นระบบ LIFF App
                await liff.init({ liffId: MY_LIFF_ID });

                // เช็คว่าผู้ใช้ล็อกอินหรือยัง ถ้ายังให้พาไปล็อกอินก่อน
                if (!liff.isLoggedIn()) {
                    liff.login();
                    return;
                }

                document.getElementById("status-text").innerText = "กำลังเปิดหน้าต่างเลือกผู้รับ...";

                // 3. ตรวจสอบว่าเปิดสิทธิ์ ShareTargetPicker ใน LINE Developer Console แล้วหรือยัง
                if (liff.isApiAvailable('shareTargetPicker')) {
                    
                    // 🛠️ โครงสร้างข้อมูล Flex Message ที่ต้องการส่งแชร์ต่อ (คัดลอกหน้าตามาจากฝั่ง Google Apps Script ได้เลย)
                    // หมายเหตุ: โค้ดส่วนนี้สามารถเขียนระบบดึงค่าแบบ Dynamic ผ่าน URL Param ได้ในอนาคตครับ
                    const result = await liff.shareTargetPicker([
                        {
                            "type": "flex",
                            "altText": "🔔 มีการแชร์ข้อมูลแจ้งชำระเงิน",
                            "contents": {
                                "type": "bubble",
                                "header": {
                                    "type": "box", "layout": "vertical", "backgroundColor": "#1DB446",
                                    "contents": [{ "type": "text", "text": "🔔 ข้อมูลแจ้งชำระเงิน (แชร์ต่อ)", "weight": "bold", "size": "lg", "color": "#ffffff" }]
                                },
                                "body": {
                                    "type": "box", "layout": "vertical", "spacing": "md",
                                    "contents": [
                                        {
                                            "type": "box", "layout": "horizontal",
                                            "contents": [
                                                { "type": "text", "text": "ตรวจสอบข้อมูล:", "size": "sm", "color": "#666666", "weight": "bold" }
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    ]);

                    if (result) {
                        // แชร์สำเร็จ ปิดหน้าต่าง LIFF ทันที
                        document.getElementById("status-text").innerText = "แชร์ข้อความเรียบร้อยแล้ว!";
                        setTimeout(() => { liff.closeWindow(); }, 1500);
                    } else {
                        // ผู้ใช้กดยกเลิก
                        liff.closeWindow();
                    }

                } else {
                    alert("ฟีเจอร์ ShareTargetPicker ยังไม่ได้เปิดใช้งานในระบบของคุณ");
                    liff.closeWindow();
                }

            } catch (error) {
                document.getElementById("status-text").innerText = "เกิดข้อผิดพลาด: " + error.message;
            }
        }

        main();
    </script>
</body>
</html>
